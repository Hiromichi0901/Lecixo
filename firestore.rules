rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Per-user data (users/{uid}/vocabulary/{wordId} and any future
    // subcollections) is readable and writable only by that signed-in user.
    // Anonymous auth and Google Sign-In both set request.auth.uid.
    // Paths that do not match are denied by default.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
