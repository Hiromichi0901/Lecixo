rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Only the owner, signed in with a real account (not anonymous), can
    // read or write their own vocabulary. Everything else is denied.
    function isSignedInOwner(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    match /users/{uid}/vocabulary/{wordId} {
      allow read, write: if isSignedInOwner(uid);
    }
  }
}
